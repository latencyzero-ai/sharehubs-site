<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
  <section class="sh-page-hero" aria-label="Request a quote">
    <div class="sh-container">
      <span class="sh-hero__tag">Project Intake</span>
      <h1>Tell Us What You Need Built</h1>
      <p>Give our engineering team the information needed to understand your project and prepare a detailed, no-obligation quote.</p>
    </div>
  </section>

  <section class="sh-section" aria-labelledby="quote-form-heading">
    <div class="sh-container">
      <div class="row align-items-start g-4 g-lg-5">
        <div class="col-lg-4">
          <div class="sh-card" style="padding:var(--sh-space-8);position:sticky;top:calc(var(--sh-header-height) + var(--sh-space-6));">
            <span style="display:inline-block;color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">A Better Brief</span>
            <h2 style="font-size:var(--sh-text-2xl);margin-bottom:var(--sh-space-4);">The right details make the quote better.</h2>
            <p class="sh-text-small">You do not need a perfect engineering drawing to start. Share what you know and our team can help identify what is missing.</p>
            <div class="sh-flex sh-flex-col" style="gap:var(--sh-space-4);margin-top:var(--sh-space-8);">
              <% const prep = ['Application or intended use','Material and dimensions','Quantity or production volume','Required tolerance or finish','Target delivery date','Drawings, photos, or references']; %>
              <% prep.forEach((item,index) => { %><div class="sh-flex" style="gap:var(--sh-space-3);align-items:flex-start;"><span style="width:28px;height:28px;flex:0 0 28px;border-radius:var(--sh-radius-full);background:var(--sh-brand);color:var(--sh-white);display:flex;align-items:center;justify-content:center;font-size:var(--sh-text-xs);font-weight:700;"><%= index + 1 %></span><span class="sh-text-small" style="color:var(--sh-text-secondary);"><%= item %></span></div><% }) %>
            </div>
            <div style="margin-top:var(--sh-space-8);padding-top:var(--sh-space-6);border-top:1px solid var(--sh-border);"><span class="sh-text-small">Expected response</span><p style="font-weight:700;color:var(--sh-text);margin-top:var(--sh-space-1);">Within 24 hours</p></div>
          </div>
        </div>
        <div class="col-lg-8">
          <div class="sh-card" style="padding:var(--sh-space-8);">
            <div class="sh-section-title sh-section-title--left" style="margin-bottom:var(--sh-space-8);">
              <span style="display:inline-block;color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">Project Details</span>
              <h2 id="quote-form-heading">Build the brief</h2>
              <p>The more detail you provide, the more accurately we can assess process, materials, quantity, and delivery.</p>
            </div>
            <form action="/request-quote" method="POST">
              <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;"><label for="q-website">Website</label><input type="text" id="q-website" name="website" tabindex="-1" autocomplete="off"></div>
              <div class="row"><div class="col-md-6"><div class="sh-form-group"><label for="q-name" class="sh-label">Full Name *</label><input type="text" id="q-name" name="name" class="sh-input" required maxlength="120" autocomplete="name" placeholder="Your full name"></div></div><div class="col-md-6"><div class="sh-form-group"><label for="q-email" class="sh-label">Email *</label><input type="email" id="q-email" name="email" class="sh-input" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div></div></div>
              <div class="row"><div class="col-md-6"><div class="sh-form-group"><label for="q-phone" class="sh-label">Phone</label><input type="tel" id="q-phone" name="phone" class="sh-input" maxlength="30" autocomplete="tel" placeholder="+234 ..."></div></div><div class="col-md-6"><div class="sh-form-group"><label for="q-company" class="sh-label">Company Name</label><input type="text" id="q-company" name="company" class="sh-input" maxlength="255" placeholder="Company or organisation"></div></div></div>
              <div class="sh-form-group"><label for="q-industry" class="sh-label">Industry *</label><select id="q-industry" name="industry" class="sh-select" required><option value="">Select an industry</option><option value="agriculture">Agriculture</option><option value="automobile">Automobile</option><option value="medical">Medical</option><option value="oil-gas">Oil & Gas</option><option value="home-office">Home & Office</option><option value="other">Other</option></select></div>
              <div class="sh-form-group"><label for="q-service" class="sh-label">Service Required *</label><select id="q-service" name="service" class="sh-select" required><option value="">Select a service</option><option value="3d-printing">3D Printing</option><option value="laser-cutting">Laser Cutting</option><option value="cnc-punching">CNC Punching</option><option value="plasma-cutting">Plasma Cutting</option><option value="consultancy">Engineering Consultancy</option><option value="multiple">Multiple Services</option><option value="unsure">Not Sure — Need Advice</option></select></div>
              <div class="row"><div class="col-md-6"><div class="sh-form-group"><label for="q-quantity" class="sh-label">Estimated Quantity</label><input type="text" id="q-quantity" name="quantity" class="sh-input" maxlength="255" placeholder="e.g. 50 units, prototype, one-off"></div></div><div class="col-md-6"><div class="sh-form-group"><label for="q-timeline" class="sh-label">Desired Timeline</label><select id="q-timeline" name="timeline" class="sh-select"><option value="">Select timeline</option><option value="urgent">Urgent (within 1 week)</option><option value="standard">Standard (2–4 weeks)</option><option value="flexible">Flexible (1+ months)</option></select></div></div></div>
              <div class="sh-form-group"><label for="q-details" class="sh-label">Project Details *</label><textarea id="q-details" name="details" class="sh-textarea" maxlength="12000" placeholder="Describe dimensions, materials, tolerances, intended use, quantities, drawings, or references..." required></textarea></div>
              <div class="sh-flex sh-items-center sh-justify-between" style="gap:var(--sh-space-4);flex-wrap:wrap;"><p class="sh-text-small" style="margin:0;">Your information is used only to assess and respond to your enquiry.</p><button type="submit" class="sh-btn sh-btn--primary sh-btn--lg">Submit Quote Request</button></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %><%- include('partials/scripts') %>