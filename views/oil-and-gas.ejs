<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content">
<section class="sh-page-hero" aria-label="Oil and gas engineering"><div class="sh-container"><nav class="sh-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sh-breadcrumb__sep">/</span><span aria-current="page">Oil & Gas</span></nav><span class="sh-hero__tag">Industry / Oil & Gas</span><h1>Fabrication for Demanding Energy Operations</h1><p>Drilling components, pipeline fittings, field tools, and industrial fabrication engineered for the demanding oil and gas environment.</p></div></section>
<section class="sh-section" aria-labelledby="overview-heading"><div class="sh-container"><div class="row align-items-center g-4 g-lg-5"><div class="col-lg-6"><div class="sh-section-title sh-section-title--left" style="max-width:680px;margin-bottom:var(--sh-space-6);"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Application Focus</span><h2 id="overview-heading" style="margin-top:var(--sh-space-3);">Components designed around demanding service conditions.</h2><p>Energy operations place a premium on robust fabrication, dimensional accuracy, practical serviceability, and clear engineering requirements.</p></div><div class="sh-grid sh-grid--2"><% ['Pipeline fittings and connectors','Drilling equipment components','Field service tools and fixtures','Pressure vessel parts','Custom offshore fabrication'].forEach((item,index)=>{ %><div class="sh-flex" style="gap:var(--sh-space-3);align-items:flex-start;"><span style="color:var(--sh-brand);font-weight:800;">0<%= index+1 %></span><span class="sh-text-small"><%= item %></span></div><% }) %></div><div class="sh-flex sh-gap-4" style="margin-top:var(--sh-space-8);flex-wrap:wrap;"><a href="/request-quote" class="sh-btn sh-btn--primary">Get Oil & Gas Components</a><a href="/contact" class="sh-btn sh-btn--outline">Contact Us</a></div></div><div class="col-lg-6"><div class="sh-card" style="padding:var(--sh-space-2);overflow:hidden;"><img src="/img/oil-and-gas.jpg" alt="Oil and gas engineering" loading="lazy" width="600" height="400" style="width:100%;height:420px;object-fit:cover;border-radius:var(--sh-radius-md);"></div></div></div></div></section>
<section class="sh-section" style="background:var(--sh-surface-alt);" aria-labelledby="cap-heading"><div class="sh-container"><div class="sh-section-title"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Manufacturing Fit</span><h2 id="cap-heading" style="margin-top:var(--sh-space-3);">Capabilities for energy-sector fabrication</h2><p>We choose the process based on geometry, material, thickness, volume, and the required production outcome.</p></div><div class="sh-grid sh-grid--4"><% const caps=[['icofont-cube','3D Printing','Prototypes, tooling, and specialised low-volume components.'],['icofont-flash','Laser Cutting','Precise profiles for panels, brackets, and fittings.'],['icofont-settings','CNC Punching','Repeatable sheet-metal features for industrial assemblies.'],['icofont-fire-burn','Plasma Cutting','Heavy plate and structural fabrication for demanding applications.']]; caps.forEach(c=>{ %><article class="sh-card sh-animate" style="height:100%;"><div class="sh-service__icon" style="background:var(--sh-brand);color:var(--sh-white);margin-bottom:var(--sh-space-5);"><i class="<%= c[0] %>" aria-hidden="true"></i></div><h4><%= c[1] %></h4><p class="sh-text-small"><%= c[2] %></p></article><% }) %></div></div></section>
<section class="sh-section" aria-labelledby="process-heading"><div class="sh-container"><div class="sh-section-title sh-section-title--left" style="max-width:720px;"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Project Path</span><h2 id="process-heading" style="margin-top:var(--sh-space-3);">A controlled route from field requirement to fabricated part.</h2></div><div class="sh-grid sh-grid--4"><% [['01','Brief','Understand service conditions, geometry, material, and application.'],['02','Engineer','Review dimensions, manufacturing route, and critical requirements.'],['03','Fabricate','Produce and inspect against the agreed specification.'],['04','Deliver','Package and deliver for installation or further integration.']].forEach(s=>{ %><article class="sh-card sh-animate"><strong style="color:var(--sh-brand);font-size:var(--sh-text-3xl);"><%= s[0] %></strong><h4 style="font-size:var(--sh-text-lg);margin-top:var(--sh-space-4);"><%= s[1] %></h4><p class="sh-text-small"><%= s[2] %></p></article><% }) %></div></div></section>
<%- include('partials/cta-section') %>
</main>
<%- include('partials/footer') %><%- include('partials/scripts') %>