<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<%- include('partials/head') %>
<title>Industries We Serve | Share Hubs Engineering</title>
</head>
<body>
<%- include('partials/header') %>

<main id="main-content">
  <!-- Hero -->
  <section class="page-hero" style="background-image: url('/img/engine.png');">
    <div class="container">
      <h1 class="page-title">Industries We Serve</h1>
      <p class="page-subtitle">Precision manufacturing solutions across five key sectors.</p>
    </div>
  </section>

  <!-- Industry Grid -->
  <section class="section section-alt">
    <div class="container">
      <div class="industry-grid">
        <% const industries = [
          { name: 'Agriculture', path: '/agriculture', img: '/img/GEAR_1.png', desc: 'Tractor components, irrigation systems, and harvester parts built for Nigerian farms.' },
          { name: 'Automobile', path: '/automobile', img: '/img/GEAR_2.png', desc: 'Custom brackets, gears, and precision-machined automotive components.' },
          { name: 'Medical', path: '/medicine', img: '/img/CUTTING.png', desc: 'Surgical tool prototypes, device housings, and sterilizable metal parts.' },
          { name: 'Oil & Gas', path: '/oil-and-gas', img: '/img/BENDING.png', desc: 'Flanges, valves, and pressure-rated fittings for energy operations.' },
          { name: 'Home & Office', path: '/home-and-office', img: '/img/FABRICTING.png', desc: 'Custom furniture hardware, enclosures, and architectural metalwork.' }
        ]; %>
        <% industries.forEach(ind => { %>
          <a href="<%= ind.path %>" class="industry-card" style="background-image: url('<%= ind.img %>');">
            <div class="industry-card-overlay">
              <h3><%= ind.name %></h3>
              <p><%= ind.desc %></p>
              <span class="btn btn-sm">Explore →</span>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <%- include('partials/cta-section') %>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
</body>
</html>