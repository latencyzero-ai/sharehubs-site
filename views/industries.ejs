<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
  <!-- Page Hero -->
  <section class="sh-page-hero">
    <div class="sh-container">
      <h1>Industries We Serve</h1>
      <p>Precision manufacturing solutions across five key sectors.</p>
    </div>
  </section>

  <!-- Industries Grid -->
  <section class="sh-section">
    <div class="sh-container">
      <div class="sh-grid sh-grid--3">
        <% const industries = [
          { name: 'Agriculture', path: '/agriculture', img: '/img/GEAR_1.png', desc: 'Tractor components, irrigation systems, and harvester parts built for Nigerian farms.' },
          { name: 'Automobile', path: '/automobile', img: '/img/GEAR_2.png', desc: 'Custom brackets, gears, and precision-machined automotive components.' },
          { name: 'Medical', path: '/medicine', img: '/img/CUTTING.png', desc: 'Surgical tool prototypes, device housings, and sterilizable metal parts.' },
          { name: 'Oil & Gas', path: '/oil-and-gas', img: '/img/BENDING.png', desc: 'Flanges, valves, and pressure-rated fittings for energy operations.' },
          { name: 'Home & Office', path: '/home-and-office', img: '/img/FABRICTING.png', desc: 'Custom furniture hardware, enclosures, and architectural metalwork.' }
        ]; %>
        <% industries.forEach(ind => { %>
          <a href="<%= ind.path %>" class="sh-industry-card">
            <img src="<%= ind.img %>" alt="<%= ind.name %>" loading="lazy">
            <h3><%= ind.name %></h3>
            <p><%= ind.desc %></p>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <%- include('partials/cta-section') %>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
