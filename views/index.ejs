<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>

</head>
<body>
<%- include('partials/header') %>
<main id="main-content">

<!-- Hero -->
<section class="sh-hero" aria-label="Hero">
  <div class="sh-hero__bg">
    <img src="/img/engineering-scene-1.webp" alt="" loading="eager" width="1920" height="1080">
  </div>
  <div class="sh-container sh-hero__content">
    <span class="sh-hero__tag">Engineering & Manufacturing — Lagos, Nigeria</span>
    <h1 class="sh-hero__title">Precision Manufacturing for <span class="accent">Agriculture, Automotive, Medical & More</span></h1>
    <p class="sh-hero__desc">From concept to component — Share Hubs Engineering turns your ideas into physical reality using 3D printing, laser cutting, CNC punching, and plasma cutting.</p>
    <div class="sh-hero__actions">
      <a href="/request-quote" class="sh-btn sh-btn--primary sh-btn--lg">Discuss Your Project</a>
      <a href="/services" class="sh-btn sh-btn--ghost sh-btn--lg">Explore Capabilities</a>
    </div>
  </div>
</section>

<!-- Trust Bar -->
<section class="sh-trust" aria-label="Company facts">
  <div class="sh-container">
    <div class="sh-trust__grid">
      <div><div class="sh-trust__num">5+</div><p class="sh-trust__label">Industries Served</p></div>
      <div><div class="sh-trust__num">4</div><p class="sh-trust__label">Manufacturing Technologies</p></div>
      <div><div class="sh-trust__num">2022</div><p class="sh-trust__label">Founded in Lagos</p></div>
      <div><div class="sh-trust__num">2–10</div><p class="sh-trust__label">Expert Engineers</p></div>
    </div>
  </div>
</section>

<!-- Capabilities -->
<section class="sh-section" aria-labelledby="caps-heading">
  <div class="sh-container">
    <div class="sh-section-title">
      <h2 id="caps-heading">Manufacturing Capabilities</h2>
      <p>Modern fabrication technologies that transform designs into precision-engineered components.</p>
    </div>
    <div class="sh-grid sh-grid--4">
      <article class="sh-card sh-card--feature sh-animate">
        <div class="sh-service__icon" style="margin-bottom:var(--sh-space-4);width:56px;height:56px;font-size:24px;"><i class="icofont-cube"></i></div>
        <h3 style="font-size:var(--sh-text-xl);margin-bottom:var(--sh-space-3);">3D Printing</h3>
        <p class="sh-text-small">Rapid prototyping and production of complex geometries in plastic, resin, and metal for custom parts and low-volume runs.</p>
      </article>
      <article class="sh-card sh-card--feature sh-animate">
        <div class="sh-service__icon" style="margin-bottom:var(--sh-space-4);width:56px;height:56px;font-size:24px;"><i class="icofont-flash"></i></div>
        <h3 style="font-size:var(--sh-text-xl);margin-bottom:var(--sh-space-3);">Laser Cutting</h3>
        <p class="sh-text-small">High-precision cutting of sheet metal, acrylic, and wood with clean edges and tight tolerances for industrial applications.</p>
      </article>
      <article class="sh-card sh-card--feature sh-animate">
        <div class="sh-service__icon" style="margin-bottom:var(--sh-space-4);width:56px;height:56px;font-size:24px;"><i class="icofont-settings"></i></div>
        <h3 style="font-size:var(--sh-text-xl);margin-bottom:var(--sh-space-3);">CNC Punching</h3>
        <p class="sh-text-small">Automated punching of holes, slots, and forms in sheet metal with high repeatability for mass-produced components.</p>
      </article>
      <article class="sh-card sh-card--feature sh-animate">
        <div class="sh-service__icon" style="margin-bottom:var(--sh-space-4);width:56px;height:56px;font-size:24px;"><i class="icofont-fire-burn"></i></div>
        <h3 style="font-size:var(--sh-text-xl);margin-bottom:var(--sh-space-3);">Plasma Cutting</h3>
        <p class="sh-text-small">High-speed cutting of thick steel and aluminum plates for heavy-duty structural and industrial fabrication projects.</p>
      </article>
    </div>
  </div>
</section>

<!-- Software -->
<section class="sh-section" style="background:var(--sh-surface);" aria-labelledby="soft-heading">
  <div class="sh-container">
    <div class="sh-section-title">
      <h2 id="soft-heading">Engineering Software Stack</h2>
      <p>Industry-standard CAD, CAM, and simulation tools ensuring precision from design to production.</p>
    </div>
    <div class="sh-grid sh-grid--5" style="margin-top:var(--sh-space-10);">
      <div class="sh-card sh-text-center sh-animate"><h4 style="color:var(--sh-brand);">SolidWorks</h4><p class="sh-text-small">3D CAD Design</p></div>
      <div class="sh-card sh-text-center sh-animate"><h4 style="color:var(--sh-brand);">AutoCAD</h4><p class="sh-text-small">2D Drafting</p></div>
      <div class="sh-card sh-text-center sh-animate"><h4 style="color:var(--sh-brand);">ANSYS</h4><p class="sh-text-small">FEA Simulation</p></div>
      <div class="sh-card sh-text-center sh-animate"><h4 style="color:var(--sh-brand);">CNCKAD</h4><p class="sh-text-small">CNC Programming</p></div>
      <div class="sh-card sh-text-center sh-animate"><h4 style="color:var(--sh-brand);">Bodor Laser</h4><p class="sh-text-small">Laser Control</p></div>
    </div>
  </div>
</section>

<!-- Industries -->
<section class="sh-section" aria-labelledby="ind-heading">
  <div class="sh-container">
    <div class="sh-section-title">
      <h2 id="ind-heading">Industries We Serve</h2>
      <p>Engineering components and solutions tailored to the demands of each sector.</p>
    </div>
    <div class="row">
      <div class="col-lg-4 col-md-6 col-12 mb-4">
        <a href="/agriculture" class="sh-industry-card sh-animate">
          <img src="/img/agroback.jpeg" alt="Agricultural machinery" loading="lazy" width="400" height="300">
          <h3>Agriculture</h3><p>Irrigation systems, mechanized equipment, precision farming tools.</p>
        </a>
      </div>
      <div class="col-lg-4 col-md-6 col-12 mb-4">
        <a href="/automobile" class="sh-industry-card sh-animate">
          <img src="/img/automobile.jpg" alt="Automotive facility" loading="lazy" width="400" height="300">
          <h3>Automobile</h3><p>Vehicle parts, maintenance components, performance enhancements.</p>
        </a>
      </div>
      <div class="col-lg-4 col-md-6 col-12 mb-4">
        <a href="/medicine" class="sh-industry-card sh-animate">
          <img src="/img/med.jpeg" alt="Medical equipment" loading="lazy" width="400" height="300">
          <h3>Medical</h3><p>Custom devices, diagnostic equipment housings, healthcare infrastructure.</p>
        </a>
      </div>
      <div class="col-lg-6 col-md-6 col-12 mb-4">
        <a href="/oil-and-gas" class="sh-industry-card sh-animate">
          <img src="/img/oilfield.jpeg" alt="Oil field operations" loading="lazy" width="600" height="300">
          <h3>Oil & Gas</h3><p>Drilling components, pipeline fittings, field equipment fabrication.</p>
        </a>
      </div>
      <div class="col-lg-6 col-md-6 col-12 mb-4">
        <a href="/home-and-office" class="sh-industry-card sh-animate">
          <img src="/img/home&office.jpg" alt="Home and office products" loading="lazy" width="600" height="300">
          <h3>Home & Office</h3><p>Durable furniture, ergonomic appliances, custom fixtures.</p>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Services -->
<section class="sh-section" style="background:var(--sh-surface);" aria-labelledby="svc-heading">
  <div class="sh-container">
    <div class="sh-section-title">
      <h2 id="svc-heading">What We Offer</h2>
      <p>End-to-end engineering support from design consultation to finished product.</p>
    </div>
    <div class="row">
      <div class="col-lg-6 col-md-6 col-12 mb-4">
        <article class="sh-service sh-animate">
          <div class="sh-service__icon"><i class="icofont-gear"></i></div>
          <div>
            <h4>Manufacturing</h4>
            <p>Precision fabrication of machine components, equipment parts, and tools using 3D printing, laser, punching, and plasma technologies.</p>
          </div>
        </article>
      </div>
      <div class="col-lg-6 col-md-6 col-12 mb-4">
        <article class="sh-service sh-animate">
          <div class="sh-service__icon"><i class="icofont-brainstorming"></i></div>
          <div>
            <h4>Engineering Consultancy</h4>
            <p>Expert advice on design feasibility, material selection, manufacturing processes, and cost optimization for your projects.</p>
          </div>
        </article>
      </div>
      <div class="col-lg-6 col-md-6 col-12 mb-4">
        <article class="sh-service sh-animate">
          <div class="sh-service__icon"><i class="icofont-read-book"></i></div>
          <div>
            <h4>Research & Development</h4>
            <p>Collaborative product development, prototyping, and testing to bring innovative concepts from idea to physical reality.</p>
          </div>
        </article>
      </div>
      <div class="col-lg-6 col-md-6 col-12 mb-4">
        <article class="sh-service sh-animate">
          <div class="sh-service__icon"><i class="icofont-graduate"></i></div>
          <div>
            <h4>Training & Education</h4>
            <p>Technical training for individuals and organizations in CAD/CAM, manufacturing processes, and engineering best practices.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<!-- Process -->
<section class="sh-section" aria-labelledby="proc-heading">
  <div class="sh-container">
    <div class="sh-section-title">
      <h2 id="proc-heading">Our Process</h2>
      <p>A streamlined approach from first contact to final delivery.</p>
    </div>
    <div class="row">
      <div class="col-lg-3 col-md-6 col-12 mb-4">
        <div class="sh-step sh-animate">
          <div class="sh-step__num">1</div>
          <div class="sh-step__content">
            <h4>Consultation</h4>
            <p class="sh-text-small">Discuss your project requirements, timeline, and budget with our engineering team.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 col-12 mb-4">
        <div class="sh-step sh-animate">
          <div class="sh-step__num">2</div>
          <div class="sh-step__content">
            <h4>Design & Analysis</h4>
            <p class="sh-text-small">We create detailed CAD models and run simulations to validate the design before production.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 col-12 mb-4">
        <div class="sh-step sh-animate">
          <div class="sh-step__num">3</div>
          <div class="sh-step__content">
            <h4>Manufacturing</h4>
            <p class="sh-text-small">Precision fabrication using the optimal technology for your component requirements.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 col-12 mb-4">
        <div class="sh-step sh-animate">
          <div class="sh-step__num">4</div>
          <div class="sh-step__content">
            <h4>Delivery</h4>
            <p class="sh-text-small">Quality inspection, packaging, and delivery of your finished components.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="sh-cta" aria-labelledby="cta-heading">
  <div class="sh-container">
    <h2 id="cta-heading">Ready to Manufacture Your Next Component?</h2>
    <p>Tell us what you need and our engineers will get back to you with a tailored quote. Built for agriculture, automotive, medical, oil & gas, and more.</p>
    <div class="sh-cta__actions">
      <a href="/request-quote" class="sh-btn sh-btn--primary sh-btn--lg">Request a Quote</a>
      <a href="/contact" class="sh-btn sh-btn--ghost sh-btn--lg">Contact Us</a>
    </div>
  </div>
</section>

</main>
<%- include('partials/footer') %>
<%- include('partials/scripts') %>
</body>
</html>
