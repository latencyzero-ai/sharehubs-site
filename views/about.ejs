<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
  <section class="sh-page-hero" aria-label="About Share Hubs Engineering">
    <div class="sh-container">
      <span class="sh-hero__tag">Who We Are</span>
      <h1>Engineering Built Around Real-World Performance</h1>
      <p>A Lagos-based engineering and manufacturing company turning ideas into precision-made components for industries across Nigeria and beyond.</p>
    </div>
  </section>

  <section class="sh-section" aria-labelledby="story-heading">
    <div class="sh-container">
      <div class="row align-items-center g-4 g-lg-5">
        <div class="col-lg-7">
          <div class="sh-section-title sh-section-title--left" style="max-width:720px;margin-bottom:var(--sh-space-6);">
            <span style="display:inline-block;color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:var(--sh-weight-bold);letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">Share Hubs Engineering</span>
            <h2 id="story-heading">From engineering intent to dependable hardware.</h2>
          </div>
          <p>We combine fabrication capability, engineering judgement, and practical problem-solving to help clients move from concept to production. Our focus is not simply making parts — it is making the right part, with the right process, for the right application.</p>
          <p style="margin-top:var(--sh-space-4);">Founded in 2022 and based in Lagos, we work across agriculture, automotive, medical, oil & gas, and home & office applications.</p>
          <div class="sh-flex sh-gap-4" style="margin-top:var(--sh-space-8);flex-wrap:wrap;">
            <a href="/services" class="sh-btn sh-btn--primary">Explore Our Capabilities</a>
            <a href="/request-consultation" class="sh-btn sh-btn--outline">Talk to an Engineer</a>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="sh-card" style="padding:var(--sh-space-8);border-top:3px solid var(--sh-brand);">
            <div class="sh-grid sh-grid--2" style="gap:var(--sh-space-6);">
              <div><div style="font-size:var(--sh-text-4xl);font-weight:var(--sh-weight-bold);color:var(--sh-brand);">2022</div><p class="sh-text-small" style="margin:0;">Founded in Lagos</p></div>
              <div><div style="font-size:var(--sh-text-4xl);font-weight:var(--sh-weight-bold);color:var(--sh-brand);">5+</div><p class="sh-text-small" style="margin:0;">Industries served</p></div>
              <div><div style="font-size:var(--sh-text-4xl);font-weight:var(--sh-weight-bold);color:var(--sh-brand);">4</div><p class="sh-text-small" style="margin:0;">Core technologies</p></div>
              <div><div style="font-size:var(--sh-text-4xl);font-weight:var(--sh-weight-bold);color:var(--sh-brand);">Lagos</div><p class="sh-text-small" style="margin:0;">Nigeria headquarters</p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sh-section" style="background:var(--sh-surface-alt);" aria-labelledby="purpose-heading">
    <div class="sh-container">
      <div class="sh-section-title">
        <span style="display:inline-block;color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:var(--sh-weight-bold);letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">Direction</span>
        <h2 id="purpose-heading">Purpose, not just production.</h2>
        <p>The principles behind the way we design, fabricate, advise, and deliver.</p>
      </div>
      <div class="sh-grid sh-grid--3">
        <article class="sh-card sh-card--feature sh-animate">
          <span style="font-size:var(--sh-text-xs);font-weight:700;color:var(--sh-brand);letter-spacing:.12em;text-transform:uppercase;">01 / Vision</span>
          <h3 style="margin:var(--sh-space-4) 0;">Engineering that advances Africa.</h3>
          <p>To be a leading engineering fabrication company in Africa, delivering innovative, affordable, and sustainable solutions that improve lives and transform industries through research and technology.</p>
        </article>
        <article class="sh-card sh-card--feature sh-animate">
          <span style="font-size:var(--sh-text-xs);font-weight:700;color:var(--sh-brand);letter-spacing:.12em;text-transform:uppercase;">02 / Mission</span>
          <h3 style="margin:var(--sh-space-4) 0;">Make world-class engineering practical.</h3>
          <p>We design, fabricate, and develop products that are innovative, affordable, and sustainable while empowering industries and communities through research and technology.</p>
        </article>
        <article class="sh-card sh-card--feature sh-animate">
          <span style="font-size:var(--sh-text-xs);font-weight:700;color:var(--sh-brand);letter-spacing:.12em;text-transform:uppercase;">03 / Goal</span>
          <h3 style="margin:var(--sh-space-4) 0;">Become a trusted solution centre.</h3>
          <p>We aim to deliver sustainable engineering technologies that improve lives and strengthen industries across Africa and beyond.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="sh-section" aria-labelledby="values-heading">
    <div class="sh-container">
      <div class="sh-section-title sh-section-title--left" style="max-width:760px;">
        <span style="display:inline-block;color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:var(--sh-weight-bold);letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">How We Work</span>
        <h2 id="values-heading">Values that show up in the work.</h2>
        <p>Every drawing, component, conversation, and delivery should reflect the standard we want the company to be known for.</p>
      </div>
      <div class="sh-grid sh-grid--3">
        <% const values = [
          ['Innovation','Research and creativity applied to real engineering problems.'],
          ['Affordability','Cost-effective solutions without sacrificing quality or precision.'],
          ['Sustainability','Engineering practices designed with long-term impact in mind.'],
          ['Excellence','Precision, quality, and disciplined execution on every project.'],
          ['Integrity','Clear communication, accountability, and honest engineering advice.'],
          ['Customer-Centricity','Practical solutions built around the client and the application.']
        ]; %>
        <% values.forEach((value, index) => { %>
          <article class="sh-card sh-animate" style="min-height:100%;">
            <div style="width:44px;height:44px;border-radius:var(--sh-radius-lg);display:flex;align-items:center;justify-content:center;background:var(--sh-brand);color:var(--sh-white);font-weight:700;margin-bottom:var(--sh-space-5);"><%= String(index + 1).padStart(2,'0') %></div>
            <h4 style="margin-bottom:var(--sh-space-3);"><%= value[0] %></h4>
            <p class="sh-text-small" style="margin:0;"><%= value[1] %></p>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="sh-section" style="background:var(--sh-surface-alt);" aria-labelledby="quality-heading">
    <div class="sh-container">
      <div class="row align-items-center g-4 g-lg-5">
        <div class="col-lg-7">
          <div class="sh-section-title sh-section-title--left" style="max-width:720px;margin-bottom:var(--sh-space-6);">
            <span style="display:inline-block;color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:var(--sh-weight-bold);letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">Quality & Responsibility</span>
            <h2 id="quality-heading">A disciplined approach to quality.</h2>
            <p>We follow industry-standard safety practices and continuously improve the processes behind our fabrication work.</p>
          </div>
          <p class="sh-text-small">Share Hubs Engineering is registered with the Corporate Affairs Commission (CAC) of Nigeria and maintains active membership with the Manufacturers Association of Nigeria (MAN).</p>
        </div>
        <div class="col-lg-5">
          <div class="sh-card" style="padding:var(--sh-space-6);">
            <div class="sh-flex sh-flex-col" style="gap:var(--sh-space-3);">
              <span class="sh-cert"><i class="fa fa-check-circle"></i> CAC Registered</span>
              <span class="sh-cert"><i class="fa fa-check-circle"></i> MAN Member</span>
              <span class="sh-cert"><i class="fa fa-check-circle"></i> Quality Assured</span>
              <span class="sh-cert"><i class="fa fa-check-circle"></i> Safety Compliant</span>
              <span class="sh-cert"><i class="fa fa-check-circle"></i> Made in Nigeria</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sh-section" aria-labelledby="company-heading">
    <div class="sh-container">
      <div class="sh-section-title">
        <span style="display:inline-block;color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:var(--sh-weight-bold);letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">Company Snapshot</span>
        <h2 id="company-heading">Built in Lagos. Ready for serious work.</h2>
      </div>
      <div class="sh-card" style="padding:0;overflow:hidden;">
        <div class="row g-0">
          <div class="col-md-6" style="padding:var(--sh-space-8);border-right:1px solid var(--sh-border);">
            <div class="sh-grid sh-grid--2">
              <div><span class="sh-text-small">Headquarters</span><p style="font-weight:600;color:var(--sh-text);margin-top:var(--sh-space-1);">Lagos, Oshodi, Nigeria</p></div>
              <div><span class="sh-text-small">Industry</span><p style="font-weight:600;color:var(--sh-text);margin-top:var(--sh-space-1);">Manufacturing & Engineering</p></div>
              <div><span class="sh-text-small">Founded</span><p style="font-weight:600;color:var(--sh-text);margin-top:var(--sh-space-1);">2022</p></div>
              <div><span class="sh-text-small">Team</span><p style="font-weight:600;color:var(--sh-text);margin-top:var(--sh-space-1);">2–10 employees</p></div>
            </div>
          </div>
          <div class="col-md-6" style="padding:var(--sh-space-8);">
            <span class="sh-text-small">Contact</span>
            <p style="margin-top:var(--sh-space-2);"><a href="tel:+2349135116716" style="font-weight:600;color:var(--sh-text);">+234 913 511 6716</a></p>
            <p><a href="mailto:info@sharehubseng.com" style="font-weight:600;color:var(--sh-text);">info@sharehubseng.com</a></p>
            <div style="margin-top:var(--sh-space-6);"><a href="/contact" class="sh-btn sh-btn--outline sh-btn--sm">Contact the Team</a></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/cta-section') %>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>