<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
<style>
  .sh-contact-hero {
    background: linear-gradient(135deg, rgba(10,10,15,0.9) 0%, rgba(44,45,63,0.85) 100%),
                url('/img/engineering-scene-2.webp') center/cover no-repeat;
    padding: 140px 0 80px;
    text-align: center;
    color: #fff;
  }
  .sh-contact-hero h1 { color: #fff; margin-bottom: var(--sh-space-4); }
  .sh-contact-hero p { color: rgba(255,255,255,0.85); max-width: 500px; margin: 0 auto; }

  .sh-contact-card {
    background: var(--sh-surface);
    border: 1px solid var(--sh-border);
    border-radius: var(--sh-radius-lg);
    padding: var(--sh-space-8);
    text-align: center;
    height: 100%;
    transition: all var(--sh-transition-base);
  }
  .sh-contact-card:hover {
    box-shadow: var(--sh-shadow-lg);
    border-color: var(--sh-brand);
    transform: translateY(-4px);
  }
  .sh-contact-card__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto var(--sh-space-4);
    background: rgba(128,0,0,0.1);
    border-radius: var(--sh-radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sh-brand);
    font-size: 22px;
  }
  .sh-contact-card h4 {
    font-size: var(--sh-text-lg);
    margin-bottom: var(--sh-space-2);
  }
  .sh-contact-card p { margin: 0; }
  .sh-contact-card a {
    color: var(--sh-text-secondary);
    text-decoration: none;
  }
  .sh-contact-card a:hover {
    color: var(--sh-brand);
    text-decoration: underline;
  }

  .sh-contact-form-wrap {
    background: var(--sh-surface);
    border: 1px solid var(--sh-border);
    border-radius: var(--sh-radius-lg);
    padding: var(--sh-space-10);
  }
  @media (max-width: 768px) {
    .sh-contact-form-wrap { padding: var(--sh-space-6); }
  }
</style>
</head>
<body>
<%- include('partials/header') %>

<main id="main-content">

  <!-- Hero -->
  <section class="sh-contact-hero" aria-label="Contact hero">
    <div class="sh-container">
      <h1>Contact Share Hubs Engineering</h1>
      <p>Have a project in mind? Reach out and our engineers will respond within 24 hours.</p>
    </div>
  </section>

  <!-- Contact Cards -->
  <section class="sh-section" style="padding-bottom: 0;" aria-labelledby="contact-info-heading">
    <div class="sh-container">
      <div class="row">
        <div class="col-lg-4 col-md-4 col-12 mb-4">
          <article class="sh-contact-card">
            <div class="sh-contact-card__icon" aria-hidden="true"><i class="fa fa-phone"></i></div>
            <h4>Phone</h4>
            <p><a href="tel:+2349135116716">+234 913 511 6716</a></p>
          </article>
        </div>
        <div class="col-lg-4 col-md-4 col-12 mb-4">
          <article class="sh-contact-card">
            <div class="sh-contact-card__icon" aria-hidden="true"><i class="fa fa-envelope"></i></div>
            <h4>Email</h4>
            <p><a href="mailto:info@sharehubseng.com">info@sharehubseng.com</a></p>
          </article>
        </div>
        <div class="col-lg-4 col-md-4 col-12 mb-4">
          <article class="sh-contact-card">
            <div class="sh-contact-card__icon" aria-hidden="true"><i class="fa fa-map-marker"></i></div>
            <h4>Location</h4>
            <p>Lagos, Oshodi, Nigeria</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="sh-section" aria-labelledby="form-heading">
    <div class="sh-container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="sh-contact-form-wrap">
            <div class="sh-section-title" style="margin-bottom: var(--sh-space-8);">
              <h2 id="form-heading" style="font-size: var(--sh-text-2xl);">Send Us a Message</h2>
              <p>Fill out the form below and we will get back to you as soon as possible.</p>
            </div>
            <form action="/contact" method="POST" class="sh-form">
              <div class="row">
                <div class="col-md-6">
                  <div class="sh-form-group">
                    <label for="contact-name" class="sh-label">Full Name</label>
                    <input type="text" id="contact-name" name="name" class="sh-input" placeholder="Your full name" required autocomplete="name">
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="sh-form-group">
                    <label for="contact-email" class="sh-label">Email Address</label>
                    <input type="email" id="contact-email" name="email" class="sh-input" placeholder="your@email.com" required autocomplete="email">
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-md-6">
                  <div class="sh-form-group">
                    <label for="contact-phone" class="sh-label">Phone Number</label>
                    <input type="tel" id="contact-phone" name="phone" class="sh-input" placeholder="+234 ..." autocomplete="tel">
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="sh-form-group">
                    <label for="contact-subject" class="sh-label">Subject</label>
                    <input type="text" id="contact-subject" name="subject" class="sh-input" placeholder="How can we help?" required>
                  </div>
                </div>
              </div>
              <div class="sh-form-group">
                <label for="contact-message" class="sh-label">Message</label>
                <textarea id="contact-message" name="message" class="sh-textarea" placeholder="Describe your project, requirements, or questions..." required></textarea>
              </div>
              <div class="sh-form-group" style="margin-bottom: 0;">
                <button type="submit" class="sh-btn sh-btn--primary sh-btn--lg" style="width: 100%;">Send Message</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
</body>
</html>
