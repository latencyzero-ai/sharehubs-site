<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content">
<section class="sh-page-hero" aria-label="Automobile engineering"><div class="sh-container"><nav class="sh-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sh-breadcrumb__sep">/</span><span aria-current="page">Automobile</span></nav><span class="sh-hero__tag">Industry / Automotive</span><h1>Precision Engineering for Automotive Applications</h1><p>Maintenance parts, performance components, tooling, fittings, and replacement parts manufactured for demanding automotive use.</p></div></section>
<section class="sh-section sh-industry-overview" aria-labelledby="overview-heading"><div class="sh-container"><div class="sh-grid sh-grid--2 sh-items-center"><div><div class="sh-section-title sh-section-title--left" style="max-width:680px;margin-bottom:var(--sh-space-6);"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Application Focus</span><h2 id="overview-heading" style="margin-top:var(--sh-space-3);">Components built for fit, function, and repeatability.</h2><p>Automotive parts often need to balance dimensional accuracy, durability, serviceability, and production cost. Our process is structured around those constraints.</p></div><div class="sh-grid sh-grid--2"><% ['Vehicle maintenance and repair parts','Custom performance components','Interior and exterior fittings','Tooling and assembly jigs','Replacement parts for legacy vehicles'].forEach((item,index)=>{ %><div class="sh-flex" style="gap:var(--sh-space-3);align-items:flex-start;"><span style="color:var(--sh-brand);font-weight:800;">0<%= index+1 %></span><span class="sh-text-small"><%= item %></span></div><% }) %></div><div class="sh-flex sh-gap-4" style="margin-top:var(--sh-space-8);flex-wrap:wrap;"><a href="/request-quote" class="sh-btn sh-btn--primary">Get Automotive Parts</a><a href="/contact" class="sh-btn sh-btn--outline">Contact Us</a></div></div><div><div class="sh-industry-overview__media"><img src="/img/automobile.jpg" alt="Automobile engineering" loading="lazy" width="600" height="400"></div></div></div></div></section>
<section class="sh-section" style="background:var(--sh-surface-alt);" aria-labelledby="cap-heading"><div class="sh-container"><div class="sh-section-title"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Manufacturing Fit</span><h2 id="cap-heading" style="margin-top:var(--sh-space-3);">Capabilities for automotive work</h2><p>We match the process to geometry, material, volume, and the required production outcome.</p></div><div class="sh-grid sh-grid--4"><% const caps=[['fa-solid fa-cube','3D Printing','Prototypes, fixtures, tooling, and complex low-volume parts.'],['fa-solid fa-bolt','Laser Cutting','Precise profiles for panels, brackets, and fittings.'],['fa-solid fa-gears','CNC Punching','Repeatable holes, slots, and sheet-metal features.'],['fa-solid fa-fire-flame-curved','Plasma Cutting','Heavy structural components and thick plate fabrication.']]; caps.forEach(c=>{ %><article class="sh-card sh-animate" style="height:100%;"><div class="sh-service__icon" style="background:var(--sh-brand);color:var(--sh-white);margin-bottom:var(--sh-space-5);"><i class="<%= c[0] %>" aria-hidden="true"></i></div><h4><%= c[1] %></h4><p class="sh-text-small"><%= c[2] %></p></article><% }) %></div></div></section>
<section class="sh-section" aria-labelledby="process-heading"><div class="sh-container"><div class="sh-section-title sh-section-title--left" style="max-width:720px;"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Project Path</span><h2 id="process-heading" style="margin-top:var(--sh-space-3);">From part requirement to road-ready component.</h2></div><div class="sh-grid sh-grid--4"><% [['01','Brief','Understand the vehicle, component, fitment, and operating requirement.'],['02','Engineer','Review dimensions, materials, tolerances, and manufacturing route.'],['03','Fabricate','Produce and inspect the component against the agreed specification.'],['04','Deliver','Package and deliver for installation, testing, or deployment.']].forEach(s=>{ %><article class="sh-card sh-animate"><strong style="color:var(--sh-brand);font-size:var(--sh-text-3xl);"><%= s[0] %></strong><h4 style="font-size:var(--sh-text-lg);margin-top:var(--sh-space-4);"><%= s[1] %></h4><p class="sh-text-small"><%= s[2] %></p></article><% }) %></div></div></section>
<%- include('partials/cta-section') %>
</main>
<%- include('partials/footer') %><%- include('partials/scripts') %>