<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content">
<section class="sh-page-hero" aria-label="Agriculture engineering"><div class="sh-container"><nav class="sh-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sh-breadcrumb__sep">/</span><span aria-current="page">Agriculture</span></nav><span class="sh-hero__tag">Industry / Agriculture</span><h1>Engineering for Modern Agriculture</h1><p>Custom agricultural equipment, irrigation systems, mechanized farming tools, and durable components engineered for Nigerian agriculture.</p></div></section>
<section class="sh-section" aria-labelledby="overview-heading"><div class="sh-container"><div class="row align-items-start g-4 g-lg-5"><div class="col-lg-6"><div class="sh-section-title sh-section-title--left" style="max-width:680px;margin-bottom:var(--sh-space-6);"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Application Focus</span><h2 id="overview-heading" style="margin-top:var(--sh-space-3);">Parts that have to work beyond the workshop.</h2><p>We design and fabricate components around the realities of field use: durability, serviceability, repeatability, and practical cost.</p></div><div class="sh-grid"><% ['Irrigation components and fittings','Mechanised farming equipment parts','Storage and processing equipment','Crop-specific custom tools','Durable field components'].forEach((item,index)=>{ %><div class="sh-flex" style="gap:var(--sh-space-3);align-items:flex-start;"><span style="color:var(--sh-brand);font-weight:800;">0<%= index+1 %></span><span class="sh-text-small"><%= item %></span></div><% }) %></div><div class="sh-flex sh-gap-4" style="margin-top:var(--sh-space-8);flex-wrap:wrap;"><a href="/request-quote" class="sh-btn sh-btn--primary">Get Agricultural Components</a><a href="/contact" class="sh-btn sh-btn--outline">Contact Us</a></div></div><div class="col-lg-6"><div class="sh-card" style="width:100%;max-width:520px;aspect-ratio:3/4;margin:0 auto;padding:var(--sh-space-2);overflow:hidden;display:flex;align-items:center;justify-content:center;"><img class="sh-industry-image--contain" src="/img/agric.jpg" alt="Agriculture engineering" loading="lazy" width="600" height="400" style="display:block;width:100%;height:100%;object-fit:contain;object-position:center;border-radius:var(--sh-radius-md);"></div></div></div></div></section>
<section class="sh-section" style="background:var(--sh-surface-alt);" aria-labelledby="cap-heading"><div class="sh-container"><div class="sh-section-title"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Manufacturing Fit</span><h2 id="cap-heading" style="margin-top:var(--sh-space-3);">Capabilities for agricultural applications</h2><p>From rapid prototypes to heavy-duty fabrication, we select the process that fits the application.</p></div><div class="sh-grid sh-grid--4"><% const caps=[['fa-solid fa-cube','3D Printing','Rapid prototypes and specialised low-volume parts.'],['fa-solid fa-bolt','Laser Cutting','Clean, repeatable sheet components and detailed profiles.'],['fa-solid fa-gears','CNC Punching','Consistent holes, slots, and formed sheet features.'],['fa-solid fa-fire-flame-curved','Plasma Cutting','Heavy plate and structural fabrication for field equipment.']]; caps.forEach(c=>{ %><article class="sh-card sh-animate" style="height:100%;"><div class="sh-service__icon" style="background:var(--sh-brand);color:var(--sh-white);margin-bottom:var(--sh-space-5);"><i class="<%= c[0] %>" aria-hidden="true"></i></div><h4><%= c[1] %></h4><p class="sh-text-small"><%= c[2] %></p></article><% }) %></div></div></section>
<section class="sh-section" aria-labelledby="process-heading"><div class="sh-container"><div class="sh-section-title sh-section-title--left" style="max-width:720px;"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Project Path</span><h2 id="process-heading" style="margin-top:var(--sh-space-3);">From requirement to field-ready component.</h2></div><div class="sh-grid sh-grid--4"><% [['01','Brief','Understand the crop, equipment, environment, and required output.'],['02','Engineer','Choose materials, geometry, and manufacturing process.'],['03','Fabricate','Produce and inspect the component to the agreed requirement.'],['04','Deliver','Package and deliver for installation or deployment.']].forEach(s=>{ %><article class="sh-card sh-animate"><strong style="color:var(--sh-brand);font-size:var(--sh-text-3xl);"><%= s[0] %></strong><h4 style="font-size:var(--sh-text-lg);margin-top:var(--sh-space-4);"><%= s[1] %></h4><p class="sh-text-small"><%= s[2] %></p></article><% }) %></div></div></section>
<%- include('partials/cta-section') %>
</main>
<%- include('partials/footer') %><%- include('partials/scripts') %>