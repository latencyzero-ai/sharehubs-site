<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Request a Consultation · Share Hubs Engineering</title>
  <meta name="description" content="Request expert engineering consultation from Share Hubs Engineering." />
  <link rel="icon" href="/img/share hubs engineering.png" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Sora:wght@700;800&display=swap" rel="stylesheet" />
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
  <style>
    *{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif}
    body{background:radial-gradient(circle at 30% 15%,#1b0406 0%,#0a0a0a 55%,#000 100%);
      color:#f5f5f5;min-height:100vh;padding:40px 20px}
    .wrap{max-width:640px;margin:0 auto}
    .top{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}
    .top a{color:#c9c9c9;text-decoration:none;font-size:14px;display:inline-flex;align-items:center;gap:6px}
    .top a:hover{color:#fff}
    .card{background:#121212;border:1px solid #242424;border-radius:20px;padding:40px;
      box-shadow:0 24px 60px -12px rgba(0,0,0,.6)}
    h1{font-family:'Sora',sans-serif;font-size:28px;letter-spacing:-.02em;margin-bottom:8px}
    .sub{color:#9a9a9a;font-size:14.5px;line-height:1.55;margin-bottom:28px}
    label{display:block;font-size:13px;color:#c9c9c9;margin:0 0 7px;font-weight:500}
    .field{margin-bottom:18px}
    input,select,textarea{width:100%;padding:13px 15px;background:#1a1a1a;
      border:1.5px solid transparent;border-radius:9px;color:#f5f5f5;font-size:15px;outline:none}
    input:focus,select:focus,textarea:focus{border-color:#e11d2a;background:#242424}
    textarea{resize:vertical;min-height:110px}
    .btn{width:100%;background:#e11d2a;color:#fff;border:none;padding:14px;border-radius:9px;
      font-size:15px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px}
    .btn:hover{background:#c41320}
    .hint{font-size:12.5px;color:#777;text-align:center;margin-top:14px}
    .hint a{color:#e11d2a;text-decoration:none}
    .saved-tag{font-size:12px;color:#2ecc71;display:none;margin-top:8px}
    .saved-tag.show{display:block}
    .toast{position:fixed;top:24px;left:50%;transform:translateX(-50%) translateY(-20px);
      background:#1a1a1a;border:1px solid #242424;border-left:4px solid #2ecc71;
      border-radius:11px;padding:13px 18px;font-size:14px;opacity:0;pointer-events:none;
      transition:.2s;z-index:9998}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
    .toast.err{border-left-color:#e11d2a}
    .spinner{width:16px;height:16px;border:2.5px solid rgba(255,255,255,.25);
      border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:none}
    @keyframes spin{to{transform:rotate(360deg)}}
    .bx{font-size:18px}
  </style>
  <link rel="stylesheet" href="/css/design-system.css" />
</head>
<body>
  <div class="wrap">
    <div class="top">
      <a href="/"><i class='bx bx-arrow-back'></i> Back to site</a>
      <a href="/coming-soon">Become a partner (coming soon) →</a>
    </div>
    <div class="card">
      <h1>Request a Consultation</h1>
      <p class="sub">Tell us about your challenge. No account needed to start —
        we'll only ask you to sign up when you're ready to send, so we can keep
        you updated on our response.</p>

      <form id="consultationForm" novalidate>
        <div class="field">
          <label>Your name</label>
          <input type="text" name="name" placeholder="John Doe" required />
        </div>
        <div class="field">
          <label>Email</label>
          <input type="email" name="email" placeholder="john@company.com" required />
        </div>
        <div class="field">
          <label>Company (optional)</label>
          <input type="text" name="company" placeholder="Acme Corp" />
        </div>
        <div class="field">
          <label>Phone (optional)</label>
          <input type="tel" name="phone" placeholder="+234 800 000 0000" />
        </div>
        <div class="field">
          <label>Sector</label>
          <select name="sector" required>
            <option value="" disabled selected>Select a sector</option>
            <option value="agriculture">Agriculture</option>
            <option value="automobile">Automobile</option>
            <option value="medicine">Medical / Healthcare</option>
            <option value="oil-and-gas">Oil & Gas</option>
            <option value="home-and-office">Home & Office</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field">
          <label>What do you need help with?</label>
          <textarea name="details" placeholder="Describe your project, challenge, or the kind of consultation you need..." required></textarea>
        </div>
        <button type="submit" class="btn" id="submitBtn">
          <span class="spinner" id="spinner"></span>
          <span id="btnText">Request a Consultation</span>
        </button>
        <p class="saved-tag" id="savedTag">Draft saved — it'll be here when you sign in.</p>
      </form>

      <p class="hint">Already have an account? <a href="/login?next=/request-consultation">Sign in</a></p>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <script>
  (function(){
    const form = document.getElementById('consultationForm');
    const btn = document.getElementById('submitBtn');
    const spinner = document.getElementById('spinner');
    const btnText = document.getElementById('btnText');
    const toast = document.getElementById('toast');
    const savedTag = document.getElementById('savedTag');

    function showToast(msg, isErr) {
      toast.textContent = msg;
      toast.className = 'toast' + (isErr ? ' err' : '') + ' show';
      setTimeout(() => toast.classList.remove('show'), 4000);
    }

    // Draft auto-save to localStorage
    const STORAGE_KEY = 'consultation_draft';
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const data = JSON.parse(saved);
        Object.keys(data).forEach(k => {
          const el = form.querySelector('[name="' + k + '"]');
          if (el) el.value = data[k];
        });
        savedTag.classList.add('show');
      } catch(e) {}
    }
    form.addEventListener('input', () => {
      const data = {};
      new FormData(form).forEach((v, k) => data[k] = v);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      savedTag.classList.add('show');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      btn.disabled = true;
      spinner.style.display = 'inline-block';
      btnText.textContent = 'Sending...';
      try {
        const res = await fetch('/request-consultation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form)))
        });
        const data = await res.json();
        if (res.status === 401 && data.error === 'signup_required') {
          showToast('Create an account to send & track your consultation.', true);
          setTimeout(() => location.href = '/login?next=' + encodeURIComponent('/request-consultation'), 2000);
          return;
        }
        if (!res.ok) throw new Error(data.error || 'Failed');
        showToast(data.message || 'Consultation request sent!');
        localStorage.removeItem(STORAGE_KEY);
        form.reset();
        savedTag.classList.remove('show');
      } catch (err) {
        showToast(err.message || 'Something went wrong. Please try again.', true);
      } finally {
        btn.disabled = false;
        spinner.style.display = 'none';
        btnText.textContent = 'Request a Consultation';
      }
    });
  })();
  </script>
</body>
</html>
