<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-auth-page">
  <main class="auth-card">
    <div class="brand-mark">SH</div>
    <p class="eyebrow">SHARE HUBS ENGINEERING</p>
    <h1>Create staff account</h1>
    <p class="muted">Use your company email. Verification is required before dashboard access.</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="post" action="/admin/register" class="auth-form">
      <label>Full name<input type="text" name="name" autocomplete="name" required></label>
      <label>Company email<input type="email" name="email" autocomplete="email" required placeholder="name@sharehubsengineering.com"></label>
      <label>Password<input type="password" name="password" autocomplete="new-password" minlength="10" required></label>
      <label>Confirm password<input type="password" name="password_confirmation" autocomplete="new-password" minlength="10" required></label>
      <button class="btn btn-primary" type="submit">Create account</button>
    </form>
    <p class="auth-foot">Already registered? <a href="/admin/login">Sign in</a></p>
  </main>
</body>
</html>
