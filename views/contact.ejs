<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>

</head>
<body>
<%- include('partials/header') %>
<main>

<section class="sh-page-hero" aria-label="Contact hero">
  <div class="sh-container">
    <h1>Contact Share Hubs Engineering</h1>
    <p>Have a project in mind? Reach out and our engineers will respond within 24 hours.</p>
  </div>
</section>

<section class="sh-section" style="padding-bottom:0;" aria-labelledby="contact-info-heading">
  <div class="sh-container">
    <div class="row">
      <div class="col-lg-4 col-md-4 col-12 mb-4">
        <article class="sh-contact-card sh-animate">
          <div class="sh-contact-card__icon"><i class="fa fa-phone"></i></div>
          <h4>Phone</h4>
          <p><a href="tel:+2349135116716">+234 913 511 6716</a></p>
        </article>
      </div>
      <div class="col-lg-4 col-md-4 col-12 mb-4">
        <article class="sh-contact-card sh-animate">
          <div class="sh-contact-card__icon"><i class="fa fa-envelope"></i></div>
          <h4>Email</h4>
          <p><a href="mailto:info@sharehubseng.com">info@sharehubseng.com</a></p>
        </article>
      </div>
      <div class="col-lg-4 col-md-4 col-12 mb-4">
        <article class="sh-contact-card sh-animate">
          <div class="sh-contact-card__icon"><i class="fa fa-location-dot"></i></div>
          <h4>Location</h4>
          <p>Lagos, Oshodi, Nigeria</p>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="sh-section" aria-labelledby="form-heading">
  <div class="sh-container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="sh-card" style="padding:var(--sh-space-10);">
          <div class="sh-section-title" style="margin-bottom:var(--sh-space-8);">
            <h2 id="form-heading" style="font-size:var(--sh-text-2xl);">Send Us a Message</h2>
            <p>Fill out the form below and we will get back to you as soon as possible.</p>
          </div>
          <form action="/contact" method="POST">
            <div class="row">
              <div class="col-md-6">
                <div class="sh-form-group">
                  <label for="contact-name" class="sh-label">Full Name</label>
                  <input type="text" id="contact-name" name="name" class="sh-input" placeholder="Your full name" required autocomplete="name">
                </div>
              </div>
              <div class="col-md-6">
                <div class="sh-form-group">
                  <label for="contact-email" class="sh-label">Email Address</label>
                  <input type="email" id="contact-email" name="email" class="sh-input" placeholder="your@email.com" required autocomplete="email">
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-md-6">
                <div class="sh-form-group">
                  <label for="contact-phone" class="sh-label">Phone Number</label>
                  <input type="tel" id="contact-phone" name="phone" class="sh-input" placeholder="+234 ..." autocomplete="tel">
                </div>
              </div>
              <div class="col-md-6">
                <div class="sh-form-group">
                  <label for="contact-subject" class="sh-label">Subject</label>
                  <input type="text" id="contact-subject" name="subject" class="sh-input" placeholder="How can we help?" required>
                </div>
              </div>
            </div>
            <div class="sh-form-group">
              <label for="contact-message" class="sh-label">Message</label>
              <textarea id="contact-message" name="message" class="sh-textarea" placeholder="Describe your project, requirements, or questions..." required></textarea>
            </div>
            <div class="sh-form-group" style="margin-bottom:0;">
              <button type="submit" class="sh-btn sh-btn--primary sh-btn--lg sh-w-full">Send Message</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

</main>
<%- include('partials/footer') %>
<%- include('partials/scripts') %>
</body>
</html>
