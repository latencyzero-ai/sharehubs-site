<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
  <section class="sh-page-hero" aria-label="Contact Share Hubs Engineering">
    <div class="sh-container">
      <span class="sh-hero__tag">Start a Conversation</span>
      <h1>Let's Talk About the Work</h1>
      <p>Have a project in mind? Send us the details and our engineering team will review your enquiry and respond within 24 hours.</p>
    </div>
  </section>

  <section class="sh-section" aria-labelledby="contact-heading">
    <div class="sh-container">
      <div class="sh-grid sh-grid--3">
        <article class="sh-contact-card sh-animate" style="padding:var(--sh-space-8);border-top:3px solid var(--sh-brand);">
          <div class="sh-contact-card__icon" style="background:var(--sh-brand);color:var(--sh-white);"><i class="fa fa-phone" aria-hidden="true"></i></div>
          <span class="sh-text-small">Call the team</span><h4 id="contact-heading" style="margin-top:var(--sh-space-2);">Phone</h4><p><a href="tel:+2349135116716">+234 913 511 6716</a></p>
        </article>
        <article class="sh-contact-card sh-animate" style="padding:var(--sh-space-8);border-top:3px solid var(--sh-brand);">
          <div class="sh-contact-card__icon" style="background:var(--sh-brand);color:var(--sh-white);"><i class="fa fa-envelope" aria-hidden="true"></i></div>
          <span class="sh-text-small">Send an enquiry</span><h4 style="margin-top:var(--sh-space-2);">Email</h4><p><a href="mailto:info@sharehubseng.com">info@sharehubseng.com</a></p>
        </article>
        <article class="sh-contact-card sh-animate" style="padding:var(--sh-space-8);border-top:3px solid var(--sh-brand);">
          <div class="sh-contact-card__icon" style="background:var(--sh-brand);color:var(--sh-white);"><i class="fa fa-location-dot" aria-hidden="true"></i></div>
          <span class="sh-text-small">Based in</span><h4 style="margin-top:var(--sh-space-2);">Lagos</h4><p>Oshodi, Lagos, Nigeria</p>
        </article>
      </div>
    </div>
  </section>

  <section class="sh-section" style="padding-top:0;" aria-labelledby="message-heading">
    <div class="sh-container">
      <div class="row align-items-stretch g-4 g-lg-5">
        <div class="col-lg-4">
          <div class="sh-card" style="height:100%;padding:var(--sh-space-8);background:var(--sh-charcoal);border-color:var(--sh-charcoal);">
            <span style="display:inline-block;color:var(--sh-brand-light);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">Before You Send</span>
            <h2 style="font-size:var(--sh-text-2xl);color:var(--sh-white);margin-bottom:var(--sh-space-4);">Give us enough context to help.</h2>
            <p style="color:rgba(255,255,255,.72);">The more specific the brief, the faster our team can understand the job and route it to the right capability.</p>
            <div class="sh-flex sh-flex-col" style="gap:var(--sh-space-4);margin-top:var(--sh-space-8);">
              <% const points = ['What you need manufactured','Material or preferred material','Approximate quantity','Required timeline','Drawings, dimensions, or references']; %>
              <% points.forEach((point,index) => { %><div class="sh-flex" style="gap:var(--sh-space-3);align-items:flex-start;"><span style="width:26px;height:26px;flex:0 0 26px;border-radius:50%;background:var(--sh-brand);color:var(--sh-white);display:flex;align-items:center;justify-content:center;font-size:var(--sh-text-xs);font-weight:700;"><%= index + 1 %></span><span style="color:rgba(255,255,255,.86);font-size:var(--sh-text-sm);line-height:1.5;"><%= point %></span></div><% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-8">
          <div class="sh-card" style="height:100%;padding:var(--sh-space-8);">
            <div class="sh-section-title sh-section-title--left" style="margin-bottom:var(--sh-space-8);">
              <span style="display:inline-block;color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:var(--sh-space-3);">Direct Enquiry</span>
              <h2 id="message-heading" style="font-size:var(--sh-text-3xl);">Send Us a Message</h2>
              <p>Tell us what you are working on and what you need from Share Hubs Engineering.</p>
            </div>
            <form action="/contact" method="POST">
              <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;"><label for="contact-website">Website</label><input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off"></div>
              <div class="row"><div class="col-md-6"><div class="sh-form-group"><label for="contact-name" class="sh-label">Full Name</label><input type="text" id="contact-name" name="name" class="sh-input" placeholder="Your full name" required maxlength="120" autocomplete="name"></div></div><div class="col-md-6"><div class="sh-form-group"><label for="contact-email" class="sh-label">Email Address</label><input type="email" id="contact-email" name="email" class="sh-input" placeholder="your@email.com" required maxlength="254" autocomplete="email"></div></div></div>
              <div class="row"><div class="col-md-6"><div class="sh-form-group"><label for="contact-phone" class="sh-label">Phone Number</label><input type="tel" id="contact-phone" name="phone" class="sh-input" placeholder="+234 ..." maxlength="30" autocomplete="tel"></div></div><div class="col-md-6"><div class="sh-form-group"><label for="contact-subject" class="sh-label">Subject</label><input type="text" id="contact-subject" name="subject" class="sh-input" placeholder="How can we help?" required maxlength="500"></div></div></div>
              <div class="sh-form-group"><label for="contact-message" class="sh-label">Message</label><textarea id="contact-message" name="message" class="sh-textarea" placeholder="Describe your project, requirements, or questions..." required maxlength="12000"></textarea></div>
              <div class="sh-flex sh-items-center sh-justify-between" style="gap:var(--sh-space-4);flex-wrap:wrap;"><p class="sh-text-small" style="margin:0;">We typically respond within 24 hours.</p><button type="submit" class="sh-btn sh-btn--primary sh-btn--lg">Send Message</button></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/cta-section') %>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>