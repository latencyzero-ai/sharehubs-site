
<div class="sh-preloader" id="preloader">
  <img src="/img/logo-light.png" alt="Share Hubs" class="sh-preloader__logo logo-for-light">
  <img src="/img/logo-dark.png" alt="Share Hubs" class="sh-preloader__logo logo-for-dark">
  <div class="sh-preloader__bar"><span></span></div>
</div>

<header class="sh-header" id="sh-header">
  <div class="sh-container sh-header__inner">
    <a href="/" class="sh-logo" aria-label="Share Hubs Engineering Home">
      <img src="/img/logo-light.png" alt="Share Hubs" class="logo-for-light" height="38">
      <img src="/img/logo-dark.png" alt="Share Hubs" class="logo-for-dark" height="38">
    </a>

    <%- include('navbar') %>

    <div class="sh-header-actions">
      <a href="/request-quote" class="sh-header__cta">Get a Quote</a>
      <button class="sh-theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="sh-icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="sh-icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button class="sh-menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="sh-mobile-nav" id="mobile-nav" aria-hidden="true">
  <a href="/" class="sh-mobile-nav__link <%= path === '/' ? 'is-active' : '' %>">Home</a>
  <a href="/services" class="sh-mobile-nav__link <%= path === '/services' ? 'is-active' : '' %>">Services</a>

  <button class="sh-mobile-nav__link sh-mobile-nav__dropdown-toggle" id="mobile-industries-toggle" aria-expanded="false" aria-controls="mobile-industries-menu">
    Industries
    <svg class="sh-mobile-nav__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  <div class="sh-mobile-nav__dropdown" id="mobile-industries-menu" aria-hidden="true">
    <a href="/agriculture" class="sh-mobile-nav__dropdown-link <%= path === '/agriculture' ? 'is-active' : '' %>">Agriculture</a>
    <a href="/automobile" class="sh-mobile-nav__dropdown-link <%= path === '/automobile' ? 'is-active' : '' %>">Automobile</a>
    <a href="/medicine" class="sh-mobile-nav__dropdown-link <%= path === '/medicine' ? 'is-active' : '' %>">Medical</a>
    <a href="/oil-and-gas" class="sh-mobile-nav__dropdown-link <%= path === '/oil-and-gas' ? 'is-active' : '' %>">Oil & Gas</a>
    <a href="/home-and-office" class="sh-mobile-nav__dropdown-link <%= path === '/home-and-office' ? 'is-active' : '' %>">Home & Office</a>
  </div>

  <a href="/about" class="sh-mobile-nav__link <%= path === '/about' ? 'is-active' : '' %>">About</a>
  <a href="/contact" class="sh-mobile-nav__link <%= path === '/contact' ? 'is-active' : '' %>">Contact</a>
  <a href="/faq" class="sh-mobile-nav__link <%= path === '/faq' ? 'is-active' : '' %>">FAQ</a>
  <a href="/request-quote" class="sh-btn sh-btn--primary sh-btn--lg">Get a Quote</a>
</div>
