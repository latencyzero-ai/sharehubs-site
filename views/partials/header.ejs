<a href="#main-content" class="sh-skip-link">Skip to main content</a>

<div class="sh-preloader" id="preloader">
  <img src="/img/logo-light.png" alt="Share Hubs" class="sh-preloader__logo logo-for-light">
  <img src="/img/logo-dark.png" alt="Share Hubs" class="sh-preloader__logo logo-for-dark">
  <div class="sh-preloader__bar"><span></span></div>
</div>

<header class="sh-header" id="sh-header">
  <div class="sh-container sh-header__inner">
   <a href="/" class="sh-logo" aria-label="Share Hubs Engineering Home">
  <!-- For LIGHT mode background: use logo-light.png (dark text) -->
  <img src="/img/logo-light.png" alt="Share Hubs" class="logo-for-light" height="38">
  <!-- For DARK mode background: use logo-dark.png (white text) -->
  <img src="/img/logo-dark.png" alt="Share Hubs" class="logo-for-dark" height="38">
</a>

    <%- include('navbar') %>

    <div class="sh-flex sh-items-center sh-gap-4">
      <a href="/login" class="sh-nav__link sh-hidden" style="display:inline-flex;" id="nav-login">Login</a>
      <a href="/request-quote" class="sh-header__cta">Get a Quote</a>
      <button class="sh-theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="sh-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="sh-icon-moon" viewBox="0 0 24 24" aria-hidden="true" style="display:none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button class="sh-menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="sh-mobile-nav" id="mobile-nav" aria-hidden="true">
  <a href="/" class="sh-mobile-nav__link <%= path === '/' ? 'is-active' : '' %>">Home</a>
  <a href="/about" class="sh-mobile-nav__link <%= path === '/about' ? 'is-active' : '' %>">About</a>
  <a href="/services" class="sh-mobile-nav__link <%= path === '/services' ? 'is-active' : '' %>">Services</a>
  <a href="/agriculture" class="sh-mobile-nav__link <%= path === '/agriculture' ? 'is-active' : '' %>">Agriculture</a>
  <a href="/automobile" class="sh-mobile-nav__link <%= path === '/automobile' ? 'is-active' : '' %>">Automobile</a>
  <a href="/medicine" class="sh-mobile-nav__link <%= path === '/medicine' ? 'is-active' : '' %>">Medical</a>
  <a href="/oil-and-gas" class="sh-mobile-nav__link <%= path === '/oil-and-gas' ? 'is-active' : '' %>">Oil & Gas</a>
  <a href="/home-and-office" class="sh-mobile-nav__link <%= path === '/home-and-office' ? 'is-active' : '' %>">Home & Office</a>
  <a href="/contact" class="sh-mobile-nav__link <%= path === '/contact' ? 'is-active' : '' %>">Contact</a>
  <a href="/faq" class="sh-mobile-nav__link <%= path === '/faq' ? 'is-active' : '' %>">FAQ</a>
  <a href="/request-quote" class="sh-mobile-nav__link">Get a Quote</a>
  <a href="/login" class="sh-mobile-nav__link">Login</a>
</div>
