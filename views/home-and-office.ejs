<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content">
<section class="sh-page-hero" aria-label="Home and office engineering"><div class="sh-container"><nav class="sh-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sh-breadcrumb__sep">/</span><span aria-current="page">Home & Office</span></nav><span class="sh-hero__tag">Industry / Home & Office</span><h1>Practical Engineering for Modern Spaces</h1><p>Durable furniture components, ergonomic hardware, appliance parts, fixtures, and architectural metalwork designed for home and office environments.</p></div></section>
<section class="sh-section" aria-labelledby="overview-heading"><div class="sh-container"><div class="row align-items-center g-4 g-lg-5"><div class="col-lg-6"><div class="sh-section-title sh-section-title--left" style="max-width:680px;margin-bottom:var(--sh-space-6);"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Application Focus</span><h2 id="overview-heading" style="margin-top:var(--sh-space-3);">Form, function, and durability in one brief.</h2><p>We help turn product ideas and practical requirements into robust components and fixtures that are made to fit their environment.</p></div><div class="sh-grid sh-grid--2"><% ['Custom furniture frames and fittings','Ergonomic office equipment components','Appliance parts and enclosures','Decorative metalwork and fixtures','Storage and organisation systems'].forEach((item,index)=>{ %><div class="sh-flex" style="gap:var(--sh-space-3);align-items:flex-start;"><span style="color:var(--sh-brand);font-weight:800;">0<%= index+1 %></span><span class="sh-text-small"><%= item %></span></div><% }) %></div><div class="sh-flex sh-gap-4" style="margin-top:var(--sh-space-8);flex-wrap:wrap;"><a href="/request-quote" class="sh-btn sh-btn--primary">Get Home & Office Components</a><a href="/contact" class="sh-btn sh-btn--outline">Contact Us</a></div></div><div class="col-lg-6"><div class="sh-card" style="padding:var(--sh-space-2);overflow:hidden;"><img src="/img/home-and-office.jpg" alt="Home and office engineering" loading="lazy" width="600" height="400" style="width:100%;height:420px;object-fit:cover;border-radius:var(--sh-radius-md);"></div></div></div></div></section>
<section class="sh-section" style="background:var(--sh-surface-alt);" aria-labelledby="cap-heading"><div class="sh-container"><div class="sh-section-title"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Manufacturing Fit</span><h2 id="cap-heading" style="margin-top:var(--sh-space-3);">Capabilities for products and fixtures</h2><p>From a single custom component to repeat production, process selection follows the intended use and required outcome.</p></div><div class="sh-grid sh-grid--4"><% const caps=[['fa-solid fa-cube','3D Printing','Rapid prototypes, custom fittings, and complex low-volume parts.'],['fa-solid fa-bolt','Laser Cutting','Detailed profiles for panels, brackets, signage, and fixtures.'],['fa-solid fa-gears','CNC Punching','Repeatable sheet-metal features for furniture and enclosures.'],['fa-solid fa-fire-flame-curved','Plasma Cutting','Heavy structural fabrication and thick material components.']]; caps.forEach(c=>{ %><article class="sh-card sh-animate" style="height:100%;"><div class="sh-service__icon" style="background:var(--sh-brand);color:var(--sh-white);margin-bottom:var(--sh-space-5);"><i class="<%= c[0] %>" aria-hidden="true"></i></div><h4><%= c[1] %></h4><p class="sh-text-small"><%= c[2] %></p></article><% }) %></div></div></section>
<section class="sh-section" aria-labelledby="process-heading"><div class="sh-container"><div class="sh-section-title sh-section-title--left" style="max-width:720px;"><span style="color:var(--sh-brand);font-size:var(--sh-text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Project Path</span><h2 id="process-heading" style="margin-top:var(--sh-space-3);">From idea to a finished, usable component.</h2></div><div class="sh-grid sh-grid--4"><% [['01','Brief','Understand the space, product, dimensions, use, and finish requirement.'],['02','Engineer','Develop the geometry and choose materials and fabrication method.'],['03','Fabricate','Produce and inspect the component to the agreed requirement.'],['04','Deliver','Package and deliver for installation or integration.']].forEach(s=>{ %><article class="sh-card sh-animate"><strong style="color:var(--sh-brand);font-size:var(--sh-text-3xl);"><%= s[0] %></strong><h4 style="font-size:var(--sh-text-lg);margin-top:var(--sh-space-4);"><%= s[1] %></h4><p class="sh-text-small"><%= s[2] %></p></article><% }) %></div></div></section>
<%- include('partials/cta-section') %>
</main>
<%- include('partials/footer') %><%- include('partials/scripts') %>