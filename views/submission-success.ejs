<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>
  <main id="main-content">
    <section class="sh-section" style="min-height:65vh;display:grid;place-items:center;">
      <div class="sh-container" style="max-width:760px;text-align:center;">
        <div class="sh-card" style="padding:clamp(2rem,6vw,5rem);">
          <div aria-hidden="true" style="width:64px;height:64px;margin:0 auto 1.5rem;border-radius:50%;display:grid;place-items:center;background:rgba(128,0,0,.1);color:#800000;font-size:2rem;">✓</div>
          <p class="sh-eyebrow">REQUEST RECEIVED</p>
          <h1>Thank you. We've received your <%= type %>.</h1>
          <p>Our team will review your request and contact you as soon as possible.</p>
          <p><strong>Reference: <%= referenceId %></strong></p>
          <div style="margin-top:2rem;display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
            <a class="sh-btn sh-btn--primary" href="/">Back to Home</a>
            <a class="sh-btn" href="/contact">Contact Us</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
