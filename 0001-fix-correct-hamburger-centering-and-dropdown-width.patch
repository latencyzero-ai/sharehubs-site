From b5386941da9a404141f384ee7ccc75acedbf5a71 Mon Sep 17 00:00:00 2001
From: "Claude (via chat)" <noreply@anthropic.com>
Date: Tue, 4 Aug 2026 06:52:53 +0000
Subject: [PATCH 1/2] fix: correct hamburger centering and dropdown width

- Center hamburger icon by fixing Slicknav's hardcoded asymmetric
  28px/6px top/bottom margin, without touching .slicknav_menu's own
  display mode (a prior attempt used display:flex here, which also
  flex-laid-out the dropdown list into a horizontal row when opened)
- Fix dropdown width: .slicknav_nav was constrained to its flex-item
  ancestor's narrow closed-state width (~145px, right-aligned) instead
  of spanning the full row. Position it absolutely against the
  full-width column instead, so it renders as a proper full-width
  vertical list when open
- Verified against the live app: closed-state logo/hamburger centers
  now match exactly (0px offset, was 11px), and the open dropdown
  spans the full viewport width (was constrained to ~145px)
---
 public/css/design-system.css | 25 ++++++++++++++++---------
 1 file changed, 16 insertions(+), 9 deletions(-)

diff --git a/public/css/design-system.css b/public/css/design-system.css
index e341e30..39b9e98 100644
--- a/public/css/design-system.css
+++ b/public/css/design-system.css
@@ -323,6 +323,8 @@ select:focus-visible, textarea:focus-visible {
   display: flex;                 /* logo + mobile-nav (hamburger) are siblings in this column — */
   align-items: center;           /* lay them out side by side instead of stacked, both centered */
   justify-content: space-between;
+  position: relative;            /* containing block for the dropdown below, so it spans full width
+                                     instead of being constrained to the narrow hamburger button's box */
 }
 .header .logo {
   float: none !important;        /* legacy template floats this, which stops it centering properly */
@@ -345,15 +347,20 @@ select:focus-visible, textarea:focus-visible {
 
 /* Mobile hamburger (Slicknav) — fix hardcoded asymmetric 28px/6px top/bottom
    margin baked into the vendor library, which was pushing the icon bars
-   off-center within their container */
-.header .slicknav_menu {
-  display: flex !important;
-  align-items: center !important;
-  justify-content: center !important;
-  height: 100%;
-}
+   off-center within their 48px-tall container. Only the button's own
+   margin is touched — .slicknav_menu's own display mode is left alone,
+   since forcing it to flex also flex-lays-out the dropdown list when
+   open, breaking it into a horizontal row instead of a stacked menu. */
 .header .slicknav_btn {
-  margin: 0 !important;
+  margin-top: 17px !important;
+  margin-bottom: 17px !important;
+}
+.header .slicknav_nav {
+  position: absolute !important;  /* removes it from the flex row entirely, so its width comes from */
+  top: 100% !important;           /* the full-width column below, not the narrow hamburger button */
+  left: 0 !important;
+  right: 0 !important;
+  width: auto !important;
 }
 
 /* Modal close button */
@@ -362,4 +369,4 @@ select:focus-visible, textarea:focus-visible {
   background: none; border: none; color: var(--text-500);
   font-size: 24px; line-height: 1; cursor: pointer;
 }
-.sh-modal-close:hover { color: var(--text-100); }
\ No newline at end of file
+.sh-modal-close:hover { color: var(--text-100); }
