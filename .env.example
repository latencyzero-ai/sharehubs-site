NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Feature flags
STORE_ENABLED=false

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sharehubs
DB_PORT=3306

# Tservers / cPanel SMTP — Secure SSL/TLS
# Confirmed from cPanel Connect Devices for noreply@sharehubsengineering.com
SMTP_HOST=mail.sharehubsengineering.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@sharehubsengineering.com
SMTP_PASS=your_mailbox_password
MAIL_FROM="Share Hubs Engineering <noreply@sharehubsengineering.com>"

# Departmental routing
MAIL_INFO=info@sharehubsengineering.com
MAIL_QUOTES=quotes@sharehubsengineering.com
MAIL_CONSULTATION=consultation@sharehubsengineering.com
MAIL_SUPPORT=support@sharehubsengineering.com
MAIL_ADMIN=admin@sharehubsengineering.com
