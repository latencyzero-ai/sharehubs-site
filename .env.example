NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Feature flags
STORE_ENABLED=false        # flip to true to launch the e-commerce store

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sharehubs
DB_PORT=3306

# Session — generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# cPanel SMTP
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@sharehubsengineering.com
SMTP_PASS=your_mailbox_password
MAIL_FROM="Share Hubs Engineering <noreply@sharehubsengineering.com>"

# Inbound mail — uses the Tservers/cPanel mailbox that receives customer replies.
# Use the exact IMAP host/port/security shown by cPanel -> Email Accounts -> Connect Devices.
IMAP_ENABLED=false
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=noreply@sharehubsengineering.com
IMAP_PASS=your_mailbox_password
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_MS=30000
