NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Feature flags
STORE_ENABLED=false        # flip to true to launch the e-commerce store

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sharehubs
DB_PORT=3306

# Session — generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# cPanel SMTP
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_mailbox_password
MAIL_FROM="Share Hubs Engineering <no-reply@yourdomain.com>"
